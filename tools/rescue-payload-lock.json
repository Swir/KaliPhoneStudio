{
  "schema_version": 1,
  "payload_id": "busybox-arm64-rescue-v1",
  "architecture": "arm64",
  "busybox": {
    "version": "1.38.0",
    "source_url": "https://busybox.net/downloads/busybox-1.38.0.tar.bz2",
    "source_sha256": "34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2",
    "license": "GPL-2.0-only",
    "config_path": "rescue/busybox-minimal.config"
  },
  "binary_policy": {
    "elf_class": 64,
    "endianness": "little",
    "elf_machine": 183,
    "require_static": true,
    "max_binary_bytes": 8388608
  },
  "required_applets": [
    "ash",
    "cat",
    "chmod",
    "chown",
    "cp",
    "cttyhack",
    "cut",
    "dd",
    "dmesg",
    "echo",
    "find",
    "grep",
    "hexdump",
    "kill",
    "ln",
    "ls",
    "mkdir",
    "mknod",
    "mount",
    "mv",
    "poweroff",
    "ps",
    "readlink",
    "reboot",
    "rm",
    "sed",
    "sh",
    "sha256sum",
    "sleep",
    "stat",
    "switch_root",
    "sync",
    "tail",
    "tr",
    "umount",
    "uname"
  ],
  "forbidden_remote_access_applets": [
    "ftpget",
    "ftpput",
    "httpd",
    "nc",
    "netcat",
    "telnet",
    "telnetd",
    "tftp",
    "tftpd",
    "udhcpd",
    "udhcpc",
    "wget"
  ],
  "init_template": "rescue/init",
  "network_default": "disabled",
  "ssh_default": "disabled",
  "materials": {
    "config_sha256": "5e8c561533f1dcddbd1d346a4fdc648c32ae5de7e0f547fc725844423934ffc1",
    "init_sha256": "329de79ba0f3404066685b3b424c9c00e1fb34f26cbc7303974ff9279247725f"
  },
  "build": {
    "cross_compile": "aarch64-linux-gnu-",
    "kconfig_target": "allnoconfig",
    "make_target": "busybox",
    "ldflags": "--static",
    "source_date_epoch": 0,
    "independent_builds": 2
  }
}
